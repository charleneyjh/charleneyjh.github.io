{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-vercel-skip-toolbar",
          "value": "1"
        }
      ]
    }
  ],
  "installCommand": "npm --prefix garden ci"
}
